# Supabase Dashboard > Project Settings > Data API
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Supabase Dashboard > Project Settings > API Keys > service_role
# Secret: hanya simpan di Vercel, jangan pernah pakai prefix PUBLIC_ atau commit nilainya.
SUPABASE_SERVICE_ROLE_KEY=GANTI_DENGAN_SERVICE_ROLE_KEY

# Opsional
BLACKLIST_ALLOWED_ORIGIN=*
BLACKLIST_CACHE_CONTROL=public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
BLACKLIST_MAX_DOMAINS=20000
