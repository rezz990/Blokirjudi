# Wajib — tersedia dari Supabase Dashboard > Project Settings > API.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=GANTI_DENGAN_SERVICE_ROLE_KEY

# Opsional — gunakan * agar extension dari semua browser boleh mengambil data.
BLACKLIST_ALLOWED_ORIGIN=*
BLACKLIST_CACHE_CONTROL=public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
BLACKLIST_MAX_DOMAINS=20000
